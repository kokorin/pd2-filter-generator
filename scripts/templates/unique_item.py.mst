from __future__ import annotations

from pd2_filter_generator.expression import BoolRef


class _UniqueItem(BoolRef):
    """Item type metadata."""

    # TODO: ladder is always False
    def __init__(self, value: str, ladder: bool, lvl: int, lvl_req: int): # noqa: FBT001
        super().__init__(value)
        self._ladder = ladder
        self._lvl = lvl
        self._lvl_req = lvl_req

    @property
    def ladder(self) -> bool:
        return self._ladder

    @property
    def lvl(self) -> int:
        return self._lvl

    @property
    def lvl_req(self) -> int:
        return self._lvl_req


values = [
    {{# unique_item }}
    {{ name }} := _UniqueItem(
        value="{{ code }}",
        ladder={{ ladder }},
        lvl={{ lvl }},
        lvl_req={{ lvl_req }},
    ),
    {{/ unique_item }}
]
