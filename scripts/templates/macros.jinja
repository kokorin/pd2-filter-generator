{%- macro to_snake_case(string) -%}
  {%- set result = [] -%}
  {%- set rename = {
    'class': 'class_'
  } -%}
  {%- for char in rename.get(string, string) -%}
    {%- if char.isupper() and (loop.first or result[-1] == '_') -%}
      {%- set _ = result.append(char | lower) -%}
    {%- elif char.isupper() -%}
      {%- set _ = result.append('_') -%}
      {%- set _ = result.append(char | lower) -%}
    {%- elif char.isdigit() and loop.first -%}
      {%- set digit_map = {'2': 'two_'} -%}
      {%- set _ = result.append(digit_map.get(char)) -%}
    {%- elif char.isspace() and result[-1] == '_' -%}
        {# do nothing #}
    {%- elif char ==  "'" -%}
        {# do nothing #}
    {%- elif not char.isalnum() -%}
      {%- set _ = result.append('_') -%}
    {%- else -%}
      {%- set _ = result.append(char) -%}
    {%- endif -%}
  {%- endfor -%}
  {{ result | join('') }}
{%- endmacro -%}

{# ###################################### #}

{%- macro generate_enum(
            file_name,
            class_name = None,
            code_column = None,
            metadata_columns = {},
            member_name_column = "",
            skip_members = ["None", "Not Used", "Unused", "unused", "Expansion"]
) -%}
{%- set class_name = class_name or file_name.split('.')[0].rstrip('s') -%}
"""
Generated {{ class_name }} enum from PD2 data.

DO NOT EDIT MANUALLY - regenerate with: hatch run ./scripts/generate.py generate
"""

from __future__ import annotations
from dataclasses import dataclass
from enum import Enum
from pd2_filter_generator.expression import CodeLiteral
from pd2_filter_generator.set import Set

{%- set items = fetch_and_parse(file_name) %}
{%- set member_name_column = member_name_column or items[0].keys() | first %}

{%- if metadata_columns %}
@dataclass(frozen=True)
class _Metadata:
    """Item type metadata."""
{%- for column, type in metadata_columns.items() %}
    {{ to_snake_case(column) }}: {{ type }} # "{{ column }}"
{%- endfor %}

_METADATA: dict[str, _Metadata] = {
    {%- for item in items if item.get(member_name_column) not in skip_members %}
    {%- set member_name = item.get(member_name_column) %}
    {%- set member_name_snake = to_snake_case(member_name) | upper %}
    "{{ member_name_snake | upper }}": _Metadata(
    {%- for column, type in metadata_columns.items() %}
        {%- set value = item.get(column) %}
        {{ to_snake_case(column) }}={%- if value and type == "str" -%}
            "{{ value }}"
        {%- elif value and type == 'bool' -%}
            {{ value == '1' }}
        {%- elif value and type == 'int' -%}
            {{ value }}
        {%- elif value -%}
            {{ type }}("{{ value }}")
        {%- else -%}
            None
        {%- endif  %},
    {%- endfor %}
    ),
    {%- endfor %}
}
{%- endif %}

class {{ class_name }}(Enum):
    """PD2 {{ to_snake_case(class_name).split('_') | join(' ') }} categories."""
{#- Special handling of None item types #}
{% for item in items if item.get(member_name_column) not in skip_members %}
    {%- set member_name = item.get(member_name_column) %}
    {%- set member_name_snake = to_snake_case(member_name) | upper %}
    {{ member_name_snake | upper }} = {% if code_column -%}
        CodeLiteral("{{ item.get(code_column) }}") # {{ member_name }}
    {%- else %} "{{ member_name }}"
    {%- endif %}
{%- endfor %}

{% for column, type in metadata_columns.items() %}
    @property
    def {{ to_snake_case(column) }}(self) -> {{ type }}:
        return _METADATA[self.name].{{ to_snake_case(column) }}
{% endfor %}
{%- endmacro -%}
